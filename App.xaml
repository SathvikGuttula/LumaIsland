<Application x:Class="LumaIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="IslandBlackBrush" Color="#FF0A0A0C"/>
        <SolidColorBrush x:Key="IslandPanelBrush" Color="#FF17171B"/>
        <SolidColorBrush x:Key="IslandBorderBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF9A9AA3"/>

        <LinearGradientBrush x:Key="CollapsedPurpleBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4C1D95" Offset="0"/>
            <GradientStop Color="#FF7C3AED" Offset="0.5"/>
            <GradientStop Color="#FFA855F7" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

    </Application.Resources>
</Application>