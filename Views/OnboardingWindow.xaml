<Window x:Class="LumaIsland.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to LumaIsland"
        Width="640"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF101015"
        Foreground="White">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="LumaIsland"
                       FontSize="34"
                       FontWeight="Bold"/>
            <TextBlock Text="Desktop island overlay for media and calendar"
                       Margin="0,8,0,0"
                       Foreground="#FFB3B3BD"
                       FontSize="14"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,18"
                Background="#FF1B1B1F"
                CornerRadius="18"
                Padding="18">
            <StackPanel>
                <TextBlock Text="Quick setup"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Use Settings to customize startup behavior, hover expansion, and island size."
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Foreground="#FFA3A3A8"
                           FontSize="14"/>
                <TextBlock Text="You can reopen settings anytime from the system tray icon."
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Foreground="#FFA3A3A8"
                           FontSize="14"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Open Settings"
                    Width="130"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="Settings_Click"/>
            <Button Content="Launch"
                    Width="120"
                    Height="36"
                    Background="#FF2563EB"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="Launch_Click"/>
        </StackPanel>
    </Grid>
</Window>