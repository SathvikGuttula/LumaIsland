<Window x:Class="LumaIsland.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:LumaIsland.Models"
        mc:Ignorable="d"
        Title="LumaIsland"
        Width="118"
        Height="18"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid>
        <Border x:Name="IslandChrome"
                Background="{StaticResource IslandBlackBrush}"
                BorderBrush="{StaticResource IslandBorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="12" Opacity="0.35" Color="#FF000000"/>
            </Border.Effect>

            <Grid>
                <Grid x:Name="CollapsedView">
                    <Border Width="{Binding Settings.CollapsedWidth}"
                            Height="{Binding Settings.CollapsedHeight}"
                            CornerRadius="9"
                            Background="{StaticResource IslandBlackBrush}"
                            BorderBrush="{StaticResource IslandBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,14,0"
                            CornerRadius="24"
                            Background="{StaticResource IslandPanelBrush}"
                            Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="88" Height="88" CornerRadius="18" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
                                    <Border Background="#22000000"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Now Playing"
                                           Foreground="#FFB3B3BD"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding TrackTitle}"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"/>

                                <TextBlock Text="{Binding Artist}"
                                           Foreground="#FFB3B3BD"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Content="⏮"
                                            Command="{Binding PreviousCommand}"/>
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Content="⏯"
                                            Command="{Binding PlayPauseCommand}"/>
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Content="⏭"
                                            Command="{Binding NextCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Margin="0,0,14,0"
                            CornerRadius="24"
                            Background="{StaticResource IslandPanelBrush}"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="{Binding FullMonthLabel}"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <ItemsControl ItemsSource="{Binding WeekDays}" Margin="0,14,0,10" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CalendarDay}">
                                        <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="2,0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Chip"
                                                            Background="Transparent"
                                                            CornerRadius="14"
                                                            Padding="4">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding ShortDay}"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="#FF8E8E99"
                                                                       FontSize="10.5"/>
                                                            <TextBlock Text="{Binding DayNumber}"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="White"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="14"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Chip" Property="Background" Value="#FF2563EB"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding SelectedDayLabel}"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding DaySummary}"
                                       Foreground="#FF9A9AA3"
                                       FontSize="14"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="2">
                        <Button Width="110"
                                Height="110"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#FF232328"
                                BorderBrush="#00000000"
                                Foreground="White"
                                FontSize="16"
                                Cursor="Hand"
                                Click="SettingsButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="55">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⚙" FontSize="28" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Settings" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>